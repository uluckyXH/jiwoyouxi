export function denseFruitMarket(): MarketEngine {
  const engine = new MarketEngine(731);
  engine.round.time = 1;
  engine.round.nextId = DENSE_FRUIT_POSITIONS.length + 1;
  engine.round.bodies = DENSE_FRUIT_POSITIONS.map((point: number[], index: number): MarketBody => {
    return { id: index + 1, level: point[0], x: point[1], y: point[2], vx: 0, vy: 0,
      angle: 0, born: 0, unlock: 0 };
  });
